# NeoLearner Backend Environment Variables
# Copy this file to backend/.env to configure real SMTP or HTTP email dispatch

# --- SMTP Configuration (Gmail, Outlook, Custom SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# --- Alternative: HTTP Email API Services ---
# RESEND_API_KEY=re_123456789
# SENDGRID_API_KEY=SG.123456789

# --- Database URL ---
# DATABASE_URL=sqlite:///literacy.db
